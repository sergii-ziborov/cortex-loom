    "generate": "cargo run -p cortex-eval -- corpus",
    "source": "cortex-original only — no Superpowers SKILL.md bodies",
    "roles": {
      "classification": "Qwen3-8B NPU IR",
      "micro_extract": "future Qwen3-0.6B NPU IR (not installed)",
      "digest": "qwen3.5:9b on Ollama"
    }
  },
