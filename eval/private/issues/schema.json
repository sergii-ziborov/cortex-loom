{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hidden issue or PR task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repository", "commit", "prompt", "hiddenTests"],
  "properties": {
    "id": { "type": "string" },
    "repository": { "type": "string" },
    "commit": { "type": "string", "minLength": 7 },
    "prompt": { "type": "string" },
    "hiddenTests": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  }
}
